#!/usr/bin/env bash
# Xray VLESS + REALITY + Vision 一键脚本 — 主攻 Quantumult X (QuanX)
#
# 用法:
#   bash <(curl -fsSL https://raw.githubusercontent.com/akaagiao1/<repo>/main/reality)
#   bash reality install | reconfig | uninstall [--purge] | update | restart | status | show
#   安装时有终端会问伪装域名, 回车默认 www.amazon.com, 也可自己填 (如 heiheiai.shop);
#   二次运行: bash reality 进菜单可 卸载 / 改域名 / 改端口 / 换密钥;
#   安装完自动输出 QuanX 行 + vless:// 链接 + 二维码 (终端打印 + PNG 文件)。
#
# 兼容: Debian 11/12/13, Ubuntu 20.04/22.04/24.04, Alpine Linux (OpenRC)
# 服务端: Xray-core (默认最新版, 失败时回落到已验证的 v26.10.31)
# 协议: VLESS / TCP + REALITY + xtls-rprx-vision, 默认 443, 伪装 www.amazon.com:443
#   (实测: Xray 26.10.31 对 www.apple.com / www.microsoft.com 会警告
#    “会增加服务器 IP 被 GFW 封的概率”, www.amazon.com 则不警告, 故默认用它;
#    想跟已有 sing-box 节点保持一致可用 REALITY_SNI=www.apple.com 改回去)
#
# 为 QuanX 做的取舍 (依据 QuanX 官方 sample.conf v1.5.5 build 914):
#   - 只用 TCP + Reality + Vision, 不用 WS / gRPC / XHTTP, QuanX 的 Reality 就是这条路
#   - QuanX 行必须写 obfs=over-tls + obfs-host=<SNI> + reality-base64-pubkey
#     + reality-hex-shortid + vless-flow=xtls-rprx-vision, method=none
#   - QuanX 开 Reality 后会用 iOS 26 Safari 指纹, 自定义 ALPN / session ticket
#     会被忽略, 且 Client Hello 超 1500 字节, 所以绝不能开 TCP Fast Open
#     —— 脚本输出的 QuanX 行里 deliberately 不带 fast-open, 服务端也不开
#   - shortId 固定 16 位 hex (8 字节), 与官方示例 0123456789abcdef 同长
#
# 防 CF / 防偷流量 (用户明确要求, 2026-11-06):
#   - 端口: 默认 443 保留 (Reality 必须冒充 443 上的真站, 且直连 VPS IP、
#     不走 CF 反代, 443 本身不是问题); 自定义端口绝不能是 CF 反代端口
#     (HTTP: 80 8080 8880 2052 2082 2086 2095; HTTPS: 2053 2083 2087 2096 8443)
#     —— 脚本会直接拒绝, 不悄悄放行
#   - 域名: Reality 的 dest/SNI 绝不能是 CF 的站 / 解析到 CF IP 的站。
#     原理见 XTLS 文档: 鉴权失败的流量会原样回落转发到 dest, 若 dest 是
#     CF CDN 站, 你的服务器就成了别人免费的 CF 端口转发, 扫描后会被偷流量。
#     所以根治办法是选非 CF 目标站, 而不是开 limitFallback* 限速
#     (那是可识别特征, XTLS 文档明确不建议一键脚本用)。
#     脚本在安装前会查 SNI 的解析 IP 是否落在 CF 官方 IPv4 段里, 落在就拒绝。
#   - 客户端地址 REALITY_HOST 也一样: 只能填 VPS 直连 IP 或未走 CF 反代的域名,
#     填了 CF 反代域名 Reality 握手会被 CF 终结, 直接连不上。
#   - 同时输出标准 vless:// 链接, 但 QuanX 建议直接粘贴下面的 QuanX 行,
#     不要只靠链接导入 (旧版解析器可能丢 reality 参数)
#
# 端口规则 (用户要求: 自定义或未占用):
#   默认 443; 443 被占时自动改用 20000-60000 随机未占用、非 CF 端口并明说;
#   REALITY_PORT 显式指定的端口被占时直接报错, 不悄悄换。
# 环境变量 (只在首次安装 / 无已有配置时生效, 已有配置优先保留):
#   REALITY_PORT   默认 443, 自定义如 REALITY_PORT=24443 (别用 CF 反代端口)
#   REALITY_SNI    默认 www.amazon.com (dest 与 serverNames 同值, 保持一致)
#   REALITY_TAG    默认 Reality-QuanX
#   REALITY_HOST   客户端填的地址, 默认自动探测公网 IP, 也可填域名
#   REALITY_UUID   指定 UUID, 不指定则随机生成
#   XRAY_VERSION   指定 Xray 版本, 如 v26.10.31; 不指定则取 GitHub 最新版
# 改配置用 bash reality reconfig (菜单 6), 非交互时可用:
#   REALITY_SNI / REALITY_PORT 指定新值, REALITY_REGEN_KEYS=1 换密钥+shortId,
#   REALITY_REGEN_UUID=1 同时换 UUID。
#
set -u
export LC_ALL=C

XRAY_BIN="/usr/local/bin/xray"
CONFIG_DIR="/usr/local/etc/xray"
CONFIG_FILE="${CONFIG_DIR}/config.json"
CLIENT_FILE="/root/xray-reality-client.txt"
[ -d /root ] || CLIENT_FILE="${HOME:-/tmp}/xray-reality-client.txt"
CLIENT_PNG="${CLIENT_FILE%.txt}.png"
SERVICE_NAME="xray"
FALLBACK_VERSION="v26.10.31"
DEFAULT_SNI="www.amazon.com"
DEFAULT_PORT="443"
DEFAULT_TAG="Reality-QuanX"
# Cloudflare 官方反代端口 (developers.cloudflare.com/fundamentals/reference/network-ports)
CF_HTTP_PORTS="80 8080 8880 2052 2082 2086 2095"
CF_HTTPS_PORTS="443 2053 2083 2087 2096 8443"
# Cloudflare 官方 IPv4 段 (www.cloudflare.com/ips-v4, 2026-11-06 核对, 共 15 段)
CF_IPV4_CIDRS="103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { printf '%b[INFO]%b %s\n' "$GREEN" "$NC" "$*"; }
warn()  { printf '%b[WARN]%b %s\n' "$YELLOW" "$NC" "$*"; }
error() { printf '%b[ERROR]%b %s\n' "$RED" "$NC" "$*" >&2; }
die()   { error "$*"; exit 1; }

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      warn "当前不是 root, 尝试用 sudo 重新执行"
      exec sudo -E bash "$0" "$@"
    fi
    die "请用 root 运行: sudo bash $0"
  fi
}

# ---- Cloudflare 防护: 端口 / 域名 / 客户端地址 ---------------------------
is_cf_port() { # $1=port ; 443 只许做默认值, 自定义端口一律禁 CF 列表
  local p="$1" x
  [ "$p" = "443" ] && return 1
  for x in $CF_HTTP_PORTS $CF_HTTPS_PORTS; do [ "$p" = "$x" ] && return 0; done
  return 1
}

validate_port() { # $1=port
  local p="$1"
  case "$p" in ''|*[!0-9]*) die "端口无效: $p" ;; esac
  [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || die "端口越界: $p"
  if is_cf_port "$p"; then
    die "端口 $p 是 Cloudflare 反代端口 (HTTP: $CF_HTTP_PORTS; HTTPS: $CF_HTTPS_PORTS), 不能用。默认 443 除外, 自定义请换一个不在该列表里的端口, 例如 24443"
  fi
}

ip_to_int() { # 1.2.3.4 -> 整数
  local IFS=. a b c d
  read -r a b c d <<EOF
$1
EOF
  printf '%s' "$(( (a << 24) + (b << 16) + (c << 8) + d ))"
}

ip_in_cidr() { # $1=ip $2=cidr ; 在段内返回 0
  local ip="$1" cidr="$2" net bits mask
  net="${cidr%/*}"; bits="${cidr#*/}"
  case "$ip" in *:*|*[^0-9.]*) return 1 ;; esac
  mask=$(( (0xffffffff << (32 - bits)) & 0xffffffff ))
  [ $(( $(ip_to_int "$ip") & mask )) -eq $(( $(ip_to_int "$net") & mask )) ]
}

is_cf_ip() { # $1=ip ; 是 CF IP 返回 0
  local ip="$1" cidr
  case "$ip" in
    2400:cb00:*|2606:4700:*|2803:f800:*|2405:b500:*|2405:8100:*|2a06:98c0:*|2c0f:f248:*) return 0 ;;
    *:* ) return 1 ;;
  esac
  for cidr in $CF_IPV4_CIDRS; do ip_in_cidr "$ip" "$cidr" && return 0; done
  return 1
}

resolve_ips() { # $1=域名 ; 输出每行一个解析 IP, 解析失败输出空
  local host="$1"
  if command -v getent >/dev/null 2>&1; then
    getent ahosts "$host" 2>/dev/null | awk '{print $1}' | sort -u
  elif command -v dig >/dev/null 2>&1; then
    dig +short "$host" 2>/dev/null | grep -v '\.$' | sort -u
  elif command -v nslookup >/dev/null 2>&1; then
    nslookup "$host" 2>/dev/null | awk '/^Address: /{print $2}' | sort -u
  fi
}

validate_sni() { # $1=sni ; 是 CF 站直接拒绝安装
  local sni="$1" lower ip ips
  lower="$(printf '%s' "$sni" | tr 'A-Z' 'a-z')"
  case "$lower" in
    *cloudflare*) die "Reality 域名 $sni 是 Cloudflare 的站, 不能做 dest/SNI, 会被偷流量。换一个非 CF 的站, 例如 www.amazon.com" ;;
  esac
  ips="$(resolve_ips "$sni")"
  if [ -z "$ips" ]; then
    warn "解析不到 $sni, 无法核对它是不是 CF IP, 继续安装; 装完请自行确认该站不在 CF 后面"
    return 0
  fi
  for ip in $ips; do
    if is_cf_ip "$ip"; then
      die "Reality 域名 $sni 解析到 Cloudflare IP $ip, 是 CF CDN 站, 不能做 dest/SNI, 会被偷流量。换一个非 CF 的站, 例如 www.amazon.com"
    fi
  done
  info "SNI 检查通过: $sni 解析到 $(printf '%s' "$ips" | tr '\n' ' ') (均非 CF IP)"
}

validate_host() { # $1=REALITY_HOST ; 是域名且解析到 CF 则拒绝
  local host="$1" ips ip
  case "$host" in
    [0-9]*.[0-9]*.[0-9]*.[0-9]*)
      is_cf_ip "$host" && die "客户端地址 $host 是 Cloudflare IP, Reality 不能走 CF 反代, 请填 VPS 直连 IP"
      return 0 ;;
  esac
  case "$host" in *.*) ;; *) return 0 ;; esac
  ips="$(resolve_ips "$host")"
  [ -z "$ips" ] && return 0
  for ip in $ips; do
    is_cf_ip "$ip" && die "客户端地址 $host 解析到 Cloudflare IP $ip, Reality 不能走 CF 反代域名, 请填 VPS 直连 IP 或未走 CF 反代的域名"
  done
}

# ---- 端口: 自定义或未占用 -------------------------------------------------
port_in_use() { # $1=port ; 被占用返回 0
  local p="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -tln 2>/dev/null | grep -qE "[:.]${p}[[:space:]]" && return 0 || return 1
  fi
  # 没 ss 时用 bash 内置 /dev/tcp 探一下 (子 shell 里超时失败即未占用)
  (exec 3<>"/dev/tcp/127.0.0.1/${p}") 2>/dev/null && return 0 || return 1
}

port_owner_is_xray() { # $1=port ; 占用者是 Xray 自己返回 0 (重装时就是它)
  local p="$1"
  command -v ss >/dev/null 2>&1 || return 1
  ss -tlnp 2>/dev/null | grep -E "[:.]${p}[[:space:]]" | grep -qi 'xray'
}

pick_free_port() { # 在 20000-60000 随机挑一个未占用、非 CF 的端口
  local i cand
  for i in $(seq 1 100); do
    if command -v shuf >/dev/null 2>&1; then cand="$(shuf -i 20000-60000 -n 1)"
    else cand="$((20000 + RANDOM % 40001))"; fi
    is_cf_port "$cand" && continue
    port_in_use "$cand" && continue
    printf '%s' "$cand"; return 0
  done
  die "100 次都没挑到未占用端口, 请手动用 REALITY_PORT 指定一个未占用端口"
}

# ---- 系统识别 -------------------------------------------------------------
OS_ID=""; OS_VER=""; INIT="none"; ARCH_RAW=""; XRAY_ASSET=""
detect_os() {
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    OS_ID="${ID:-}"; OS_VER="${VERSION_ID:-}"
  fi
  case "$OS_ID" in
    debian|ubuntu) ;;
    alpine) ;;
    *) die "不支持的系统: ${OS_ID:-未知} (只支持 Debian / Ubuntu / Alpine)" ;;
  esac
  ARCH_RAW="$(uname -m)"
  case "$ARCH_RAW" in
    x86_64|amd64)   XRAY_ASSET="Xray-linux-64.zip" ;;
    aarch64|arm64)  XRAY_ASSET="Xray-linux-arm64-v8a.zip" ;;
    armv7l)         XRAY_ASSET="Xray-linux-arm32-v7a.zip" ;;
    armv6l)         XRAY_ASSET="Xray-linux-arm32-v6.zip" ;;
    armv5*)         XRAY_ASSET="Xray-linux-arm32-v5.zip" ;;
    i386|i686)      XRAY_ASSET="Xray-linux-32.zip" ;;
    riscv64)        XRAY_ASSET="Xray-linux-riscv64.zip" ;;
    *) die "不支持的架构: $ARCH_RAW" ;;
  esac
  info "系统: $OS_ID $OS_VER, 架构: $ARCH_RAW -> $XRAY_ASSET"
}

detect_init() {
  # Alpine 教训: 先装依赖 (含 openrc) 再检测 init, 精简版 Alpine 没预装 openrc
  # 时直接检测会误判; 这里只做检测, 安装依赖在 install_deps 里先行完成.
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    INIT="systemd"
  elif command -v rc-service >/dev/null 2>&1 || [ -d /etc/init.d ]; then
    INIT="openrc"
  else
    INIT="none"
  fi
  info "初始化系统: $INIT"
}

install_deps() {
  info "安装依赖..."
  # 依赖都已齐全时跳过包管理器: 重装/改配置不必再跑一遍 apt/apk,
  # 也避免系统包状态异常 (如有损坏的包) 时把本来能跑的改配置挡住
  local need_install=0 c
  for c in curl wget unzip openssl jq; do
    command -v "$c" >/dev/null 2>&1 || need_install=1
  done
  command -v ss >/dev/null 2>&1 || need_install=1
  command -v pgrep >/dev/null 2>&1 || need_install=1
  [ -f /etc/ssl/certs/ca-certificates.crt ] || need_install=1
  [ "$OS_ID" = "alpine" ] && { command -v rc-service >/dev/null 2>&1 || need_install=1; }
  if [ "$need_install" = "0" ]; then
    info "依赖已齐全, 跳过包管理器安装"
  else
    _install_deps_pkg
  fi
  # qrencode 只做二维码, 单独尽力装, 装不上也不中断安装 (show 时会提示)
  if ! command -v qrencode >/dev/null 2>&1; then
    case "$OS_ID" in
      debian|ubuntu)
        apt-get install -y qrencode 2>/dev/null || warn "qrencode 安装失败, 本次没有二维码; 装好后跑 bash reality show 可补生成"
        ;;
      alpine)
        # Alpine 里二维码命令行不在 qrencode 包里, 在 libqrencode-tools 里,
        # apk add qrencode 在 Alpine 上永远报 no such package;
        # 依赖已齐全时上面没跑 apk update, 这里先更索引再装
        apk update >/dev/null 2>&1
        apk add --no-cache libqrencode-tools 2>/dev/null || warn "qrencode 未装上, 本次没有二维码; 装好后跑 bash reality show 可补生成"
        ;;
    esac
  fi
}

_install_deps_pkg() {
  case "$OS_ID" in
    debian|ubuntu)
      export DEBIAN_FRONTEND=noninteractive
      timeout 90 apt-get update -y || warn "apt update 失败/超时, 继续尝试安装依赖"
      apt-get install -y curl wget unzip ca-certificates openssl jq iproute2 procps || \
        apt-get install -y curl wget unzip ca-certificates openssl jq || \
        die "依赖安装失败"
      ;;
    alpine)
      # 精简版 Alpine 出厂没有仓库索引 (/lib/apk/db 里没有 APKINDEX),
      # 不先 apk update 的话 apk add 直接报 no such package, 依赖装不上;
      # update 失败也继续试 (索引可能已在缓存里), 装不上再报错
      apk update >/dev/null 2>&1 || warn "apk update 失败, 尝试用现有索引继续安装"
      # 先装 openrc 再检测 init (见 detect_init 注释, 精简版 Alpine 必需);
      # ss 不在 iproute2 里, 在 iproute2-ss 里, 不装它端口占用判断会失灵
      # (port_owner_is_xray 认不出占用者是 Xray 自己, 重装会误判端口被占)
      apk add --no-cache bash curl wget unzip ca-certificates openssl jq openrc iproute2 iproute2-ss procps 2>/dev/null || \
        apk add --no-cache bash curl wget unzip ca-certificates openssl jq openrc iproute2-ss || \
        die "依赖安装失败 (apk)"
      update-ca-certificates 2>/dev/null || true
      ;;
  esac
}

# ---- Xray 版本 / 下载 ------------------------------------------------------
latest_xray_version() {
  local ver=""
  ver="$(curl -fsSL --max-time 15 "https://api.github.com/repos/XTLS/Xray-core/releases/latest" 2>/dev/null \
    | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')"
  if [ -n "$ver" ]; then printf '%s' "$ver"; else printf '%s' "$FALLBACK_VERSION"; fi
}

download_xray() {
  local version="${XRAY_VERSION:-$(latest_xray_version)}"
  local url="https://github.com/XTLS/Xray-core/releases/download/${version}/${XRAY_ASSET}"
  local tmpdir; tmpdir="$(mktemp -d)"
  info "下载 Xray-core ${version} (${XRAY_ASSET})..."
  if ! curl -fL --retry 2 --max-time 120 -o "${tmpdir}/xray.zip" "$url"; then
    if [ "$version" != "$FALLBACK_VERSION" ]; then
      warn "最新版下载失败, 回落到已验证版本 $FALLBACK_VERSION"
      version="$FALLBACK_VERSION"
      url="https://github.com/XTLS/Xray-core/releases/download/${version}/${XRAY_ASSET}"
      curl -fL --retry 2 --max-time 120 -o "${tmpdir}/xray.zip" "$url" || die "Xray 下载失败: $url"
    else
      die "Xray 下载失败: $url"
    fi
  fi
  # 有 .dgst 就验 sha256, 验不过直接停, 不装来路不明的文件
  if curl -fsSL --max-time 30 -o "${tmpdir}/xray.zip.dgst" "${url}.dgst" 2>/dev/null; then
    local want; want="$(grep -i 'SHA256' "${tmpdir}/xray.zip.dgst" | head -1 | awk '{print $NF}')"
    if [ -n "$want" ]; then
      local got; got="$(sha256sum "${tmpdir}/xray.zip" 2>/dev/null | awk '{print $1}')"
      [ "$got" = "$want" ] || die "Xray 校验失败 (sha256 不符), 已停止安装"
      info "sha256 校验通过"
    fi
  else
    warn "未拿到 .dgst, 跳过 sha256 校验"
  fi
  mkdir -p "${tmpdir}/x"
  unzip -o -q "${tmpdir}/xray.zip" -d "${tmpdir}/x" || die "解压 Xray 失败"
  [ -x "${tmpdir}/x/xray" ] || die "解压后找不到 xray 可执行文件"
  mkdir -p "$(dirname "$XRAY_BIN")" /usr/local/share/xray
  install -m 755 "${tmpdir}/x/xray" "$XRAY_BIN"
  for dat in geoip.dat geosite.dat; do
    [ -f "${tmpdir}/x/${dat}" ] && install -m 644 "${tmpdir}/x/${dat}" "/usr/local/share/xray/${dat}"
  done
  rm -rf "$tmpdir"
  info "Xray 已装到 $XRAY_BIN, 版本: $($XRAY_BIN version 2>/dev/null | head -1)"
}

# ---- 已有配置读取 (升级/重装保留) ------------------------------------------
json_get() { # $1=file $2=jq表达式
  [ -f "$1" ] && command -v jq >/dev/null 2>&1 && jq -r "$2 // empty" "$1" 2>/dev/null
}

existing_value() { # $1=key: uuid|priv|pub|shortid|port|sni
  [ -f "$CONFIG_FILE" ] || return 0
  case "$1" in
    uuid)    json_get "$CONFIG_FILE" '.inbounds[0].settings.clients[0].id' ;;
    priv)    json_get "$CONFIG_FILE" '.inbounds[0].streamSettings.realitySettings.privateKey' ;;
    port)    json_get "$CONFIG_FILE" '.inbounds[0].port' ;;
    sni)     json_get "$CONFIG_FILE" '.inbounds[0].streamSettings.realitySettings.serverNames[0]' ;;
    shortid) json_get "$CONFIG_FILE" '.inbounds[0].streamSettings.realitySettings.shortIds[0]' ;;
  esac
}

gen_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then uuidgen
  else "$XRAY_BIN" uuid 2>/dev/null | tr -d ' \r\n'; fi
}

gen_keypair() { # 输出两行: 私钥 / 公钥
  local out priv pub
  out="$("$XRAY_BIN" x25519 2>/dev/null)" || die "xray x25519 生成密钥失败"
  # 新版输出 "Private key: xxx" / "Public key: yyy", 兼容 "PrivateKey:" 写法
  priv="$(printf '%s' "$out" | grep -i 'private' | head -1 | sed -E 's/.*:[[:space:]]*//;s/[[:space:]]//g')"
  pub="$(printf '%s' "$out" | grep -i 'public' | head -1 | sed -E 's/.*:[[:space:]]*//;s/[[:space:]]//g')"
  [ -n "$priv" ] && [ -n "$pub" ] || die "解析 x25519 密钥失败, xray 输出: $out"
  printf '%s\n%s\n' "$priv" "$pub"
}

public_ip() {
  local ip=""
  ip="$(curl -4fsSL --max-time 8 https://ifconfig.me 2>/dev/null | tr -d ' \r\n')" || true
  [ -n "$ip" ] || ip="$(curl -4fsSL --max-time 8 https://api.ipify.org 2>/dev/null | tr -d ' \r\n')" || true
  # BusyBox hostname 没有 -I (Alpine 上直接报错), 先用 ip 命令取本机 IP
  [ -n "$ip" ] || ip="$(ip -4 addr show scope global 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)"
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  printf '%s' "$ip"
}

# ---- 服务 -----------------------------------------------------------------
stop_service() {
  case "$INIT" in
    systemd) systemctl stop "$SERVICE_NAME" 2>/dev/null || true ;;
    openrc)  rc-service "$SERVICE_NAME" stop 2>/dev/null || true ;;
  esac
}

install_service() {
  case "$INIT" in
    systemd)
      cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<EOF
[Unit]
Description=Xray Service (VLESS + REALITY, QuanX)
Documentation=https://github.com/XTLS/Xray-core
After=network.target nss-lookup.target

[Service]
User=root
ExecStart=${XRAY_BIN} run -config ${CONFIG_FILE}
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF
      systemctl daemon-reload
      systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || warn "systemctl enable 失败, 服务仍可手动启动"
      ;;
    openrc)
      cat > "/etc/init.d/${SERVICE_NAME}" <<EOF
#!/sbin/openrc-run
name="xray"
description="Xray Service (VLESS + REALITY, QuanX)"
command="${XRAY_BIN}"
command_args="run -config ${CONFIG_FILE}"
command_background=true
pidfile="/run/\${RC_SVCNAME}.pid"
depend() {
  need net
  after firewall
}
EOF
      chmod +x "/etc/init.d/${SERVICE_NAME}"
      rc-update add "$SERVICE_NAME" default >/dev/null 2>&1 || warn "rc-update add 失败, 服务仍可手动启动"
      ;;
    none)
      warn "未识别到 systemd / OpenRC, 不创建开机服务, 需手动运行: $XRAY_BIN run -config $CONFIG_FILE"
      ;;
  esac
}

start_service() {
  case "$INIT" in
    systemd) systemctl restart "$SERVICE_NAME" || die "systemctl 启动 xray 失败, 看日志: journalctl -u xray -n 50" ;;
    openrc)  rc-service "$SERVICE_NAME" restart 2>/dev/null || rc-service "$SERVICE_NAME" start || die "OpenRC 启动 xray 失败, 看日志: rc-service xray status" ;;
    none)    nohup "$XRAY_BIN" run -config "$CONFIG_FILE" >/var/log/xray.log 2>&1 &
             info "已用 nohup 后台启动 (无 init 系统), 日志 /var/log/xray.log" ;;
  esac
  sleep 2
}

service_active() {
  case "$INIT" in
    systemd) systemctl is-active --quiet "$SERVICE_NAME" ;;
    openrc)  rc-service "$SERVICE_NAME" status 2>/dev/null | grep -qi 'started' ;;
    none)    pgrep -x xray >/dev/null 2>&1 ;;
  esac
}

open_firewall() { # $1=port
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'active'; then
    ufw allow "$1/tcp" >/dev/null 2>&1 && info "UFW 已放行 $1/tcp" || warn "UFW 放行失败, 请手动放行 $1/tcp"
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
    firewall-cmd --permanent --add-port="$1/tcp" >/dev/null 2>&1 && firewall-cmd --reload >/dev/null 2>&1 && info "firewalld 已放行 $1/tcp" || warn "firewalld 放行失败"
  elif command -v iptables >/dev/null 2>&1; then
    iptables -C INPUT -p tcp --dport "$1" -j ACCEPT 2>/dev/null || \
      iptables -I INPUT -p tcp --dport "$1" -j ACCEPT 2>/dev/null || true
  fi
}

try_bbr() {
  # 尽力而为, 内核不支持也不报错中断安装 (与 snell-v6 同款做法)
  if [ -w /proc/sys/net/ipv4/tcp_congestion_control ]; then
    sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 || true
    sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1 || true
  fi
}

# ---- 安装 / 输出 -----------------------------------------------------------
prompt_sni() { # $1=当前值(已有配置或默认) ; 交互时让用户自选伪装域名, 输出选定的 sni
  # 提示走 stderr (结果走 stdout, 调用处用 $() 接), 否则提示词会混进返回值
  local cur="$1" ans="" tries=0
  while [ "$tries" -lt 3 ]; do
    printf '伪装域名 Reality dest/SNI (回车保持 %s, 自己选如 heiheiai.shop): ' "$cur" >&2
    read -r ans || ans=""
    ans="$(printf '%s' "$ans" | tr -d ' \t\r\n')"
    [ -z "$ans" ] && { printf '%s' "$cur"; return 0; }
    # 子 shell 里校验: 不合规 (CF 站/解析到 CF IP) 只算这次输入作废, 不直接退出
    if (validate_sni "$ans" >/dev/null 2>&1); then printf '%s' "$ans"; return 0; fi
    tries=$((tries+1))
    printf '%s\n' "[WARN] 域名 $ans 不可用 (可能是 CF 站或解析到 CF IP), 请换一个 (还剩 $((3-tries)) 次)" >&2
  done
  printf '%s\n' "[ERROR] 连续 3 次输入的域名都不可用, 已停止; 也可以用 REALITY_SNI=域名 直接指定后重装" >&2
  return 1
}

write_config() { # $1=uuid $2=priv $3=shortid $4=port $5=sni ; 写配置并校验
  # 注意: 下面这行 local 必须单独成行。之前它跟在行尾 # 注释后面,
  # 整行都被当成注释, 参数根本没绑上, 函数是靠 bash 动态作用域偷看到
  # 调用者的同名 local 变量才工作的。do_install 里恰好有 port/sni
  # 同名变量所以能装, do_reconfig 里只有 new_port/new_sni,
  # port/sni 为空, heredoc 在 set -u 下直接把配置文件截成 0 字节,
  # reconfig 必挂。改成显式绑定后与调用者变量名无关。
  local uuid="$1" priv="$2" shortid="$3" port="$4" sni="$5"
  mkdir -p "$CONFIG_DIR"
  [ -f "$CONFIG_FILE" ] && cp -a "$CONFIG_FILE" "${CONFIG_FILE}.bak.$(date +%Y%m%d%H%M%S)"
  cat > "$CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "port": ${port},
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "${uuid}", "flow": "xtls-rprx-vision" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "${sni}:443",
          "xver": 0,
          "serverNames": ["${sni}"],
          "privateKey": "${priv}",
          "shortIds": ["${shortid}"]
        }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" },
    { "protocol": "blackhole", "tag": "block" }
  ]
}
EOF
  # 服务端 realitySettings 里没有 fingerprint 字段 (那是客户端的),
  # 别往里加, Xray 会直接报错; 客户端指纹在下面的链接 / QuanX 行里体现.
  "$XRAY_BIN" -test -config "$CONFIG_FILE" >/dev/null 2>&1 || \
    die "Xray 配置校验失败, 配置已写到 $CONFIG_FILE, 请检查后重试"
}

do_install() {
  need_root "$@"
  # 环境变量给的值先验一遍, 不合规在装依赖前就停, 不浪费一次 apt/apk
  [ -n "${REALITY_PORT:-}" ] && validate_port "$REALITY_PORT"
  # 显式指定的端口被占也在装依赖前就报错, 别等 apt 跑完、Xray 下完才发现
  if [ -n "${REALITY_PORT:-}" ] && port_in_use "$REALITY_PORT" && ! port_owner_is_xray "$REALITY_PORT"; then
    die "你指定的端口 $REALITY_PORT 已被占用, 请先停掉占用服务, 或换一个未占用的端口再装 (REALITY_PORT=24443 之类, 别用 CF 反代端口)"
  fi
  [ -n "${REALITY_SNI:-}" ] && validate_sni "$REALITY_SNI"
  [ -n "${REALITY_HOST:-}" ] && validate_host "$REALITY_HOST"
  detect_os
  install_deps
  detect_init

  local port="${REALITY_PORT:-$(existing_value port)}"
  [ -n "$port" ] || port="$DEFAULT_PORT"
  local sni="${REALITY_SNI:-$(existing_value sni)}"
  [ -n "$sni" ] || sni="$DEFAULT_SNI"
  if [ -t 0 ] && [ -z "${REALITY_SNI:-}" ]; then
    # 交互安装: 让用户自己选伪装域名 (用户要求, 2026-11-06), 回车保持当前值;
    # 环境变量 REALITY_SNI 指定了就跳过提问, 非交互 (管道) 也不问
    sni="$(prompt_sni "$sni")" || die "选择伪装域名失败, 也可以用 REALITY_SNI=域名 直接指定后重装"
  fi
  # CF 校验在下载 / 写配置之前做, 不合规直接停, 不浪费一次下载
  validate_port "$port"
  validate_sni "$sni"
  [ -n "${REALITY_HOST:-}" ] && validate_host "$REALITY_HOST"
  [ -x "$XRAY_BIN" ] || download_xray
  local uuid="${REALITY_UUID:-$(existing_value uuid)}"
  [ -n "$uuid" ] || uuid="$(gen_uuid)"
  local priv pub shortid
  priv="$(existing_value priv)"
  if [ -n "$priv" ]; then
    # 已有私钥则用它反推公钥, 保持客户端配置不变
    pub="$("$XRAY_BIN" x25519 -i "$priv" 2>/dev/null | grep -i 'public' | head -1 | sed -E 's/.*:[[:space:]]*//;s/[[:space:]]//g')"
    [ -n "$pub" ] || die "已有私钥无法反推公钥, 请删配置重装或检查私钥"
  else
    local kp; kp="$(gen_keypair)"
    priv="$(printf '%s' "$kp" | sed -n '1p')"
    pub="$(printf '%s' "$kp" | sed -n '2p')"
  fi
  shortid="$(existing_value shortid)"
  [ -n "$shortid" ] || shortid="$(openssl rand -hex 8 2>/dev/null || head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"

  # 端口: 自定义或未占用 (用户要求, 2026-11-06)
  #   - 显式用 REALITY_PORT 指定的端口被占: 直接报错停下, 不悄悄换掉你指定的端口
  #   - 默认 443 / 沿用旧配置的端口被占, 且占用者不是 Xray 自己:
  #     自动改用一个随机未占用、非 CF 的端口 (20000-60000), 并在输出里明说换了
  if port_in_use "$port" && ! port_owner_is_xray "$port"; then
    if [ -n "${REALITY_PORT:-}" ]; then
      die "你指定的端口 $port 已被占用, 请先停掉占用服务, 或换一个未占用的端口再装 (REALITY_PORT=24443 之类, 别用 CF 反代端口)"
    fi
    local new_port; new_port="$(pick_free_port)"
    warn "端口 $port 已被占用 (不是 Xray 自己), 自动改用未占用端口 $new_port (非 CF 反代端口)"
    info "客户端配置将按 $new_port 生成, 请按输出的 QuanX 行 / vless 链接填"
    port="$new_port"
  fi

  write_config "$uuid" "$priv" "$shortid" "$port" "$sni"

  install_service
  start_service
  service_active || die "Xray 启动后未处于运行状态, 查日志: systemd 用 journalctl -u xray -n 50; OpenRC 用 rc-service xray status"
  open_firewall "$port"
  try_bbr
  show_info "$uuid" "$pub" "$shortid" "$port" "$sni"
}

show_info() { # $1=uuid $2=pubkey $3=shortid $4=port $5=sni
  local uuid="$1" pub="$2" shortid="$3" port="$4" sni="$5"
  local host="${REALITY_HOST:-$(public_ip)}"
  local tag="${REALITY_TAG:-$DEFAULT_TAG}"
  # vless:// 链接: pbk 是 base64url 公钥, 不用再转义; sid 16 位 hex; fp=chrome
  local link="vless://${uuid}@${host}:${port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${sni}&fp=chrome&pbk=${pub}&sid=${shortid}&type=tcp&headerType=none#${tag}"
  # QuanX 行: 按官方 sample.conf vless-tls-reality-vision-01 的写法,
  # obfs=over-tls + obfs-host=<SNI>, 不带 fast-open (Reality 下必须关, 见文件头注释)
  local qx="vless=${host}:${port}, method=none, password=${uuid}, obfs=over-tls, obfs-host=${sni}, reality-base64-pubkey=${pub}, reality-hex-shortid=${shortid}, vless-flow=xtls-rprx-vision, udp-relay=true, tag=${tag}"
  # 二维码: vless:// 链接扫码即导入; 先生成 PNG, 再在终端打印一份
  local qr_note=""
  if command -v qrencode >/dev/null 2>&1; then
    if qrencode -o "$CLIENT_PNG" -s 6 -m 2 "$link" 2>/dev/null; then
      qr_note="二维码 PNG: $CLIENT_PNG (扫码即导入 vless://)"
    else
      qr_note="二维码: PNG 生成失败 (终端下方仍有二维码)"
    fi
  else
    qr_note="二维码: 未生成 (未装 qrencode; 装好后跑 bash reality show 补生成)"
  fi
  {
    printf '%s\n' "Xray VLESS + REALITY + Vision (QuanX)"
    printf '%s\n' "地址: ${host}:${port}  SNI/dest: ${sni}  指纹: chrome (服务端不填, 客户端用)"
    printf '%s\n' ""
    printf '%s\n' "--- Quantumult X (推荐, 直接粘贴到 [server_local]) ---"
    printf '%s\n' "$qx"
    printf '%s\n' ""
    printf '%s\n' "--- 通用 vless:// 链接 (其他客户端导入) ---"
    printf '%s\n' "$link"
    printf '%s\n' ""
    printf '%s\n' "UUID: $uuid"
    printf '%s\n' "公钥 pbk: $pub"
    printf '%s\n' "shortId: $shortid"
    printf '%s\n' "$qr_note"
    printf '%s\n' "私钥 (只存服务端, 别发给别人): 请看 $CONFIG_FILE"
  } | tee "$CLIENT_FILE"
  if command -v qrencode >/dev/null 2>&1; then
    printf '%s\n' "--- 二维码 (扫 vless:// 链接, 手机客户端扫码导入) ---"
    qrencode -t ANSIUTF8 "$link" 2>/dev/null || warn "终端二维码打印失败, 用上面保存的 PNG"
  fi
  printf '\n'
  info "客户端配置已保存到 $CLIENT_FILE"
  [ -f "$CLIENT_PNG" ] && info "二维码已保存到 $CLIENT_PNG"
  info "QuanX 要求 1.5.5+ 才支持 VLESS Reality + Vision, 低版本请先升级 QuanX"
  warn "私钥在 $CONFIG_FILE 里, 别把配置文件 / 客户端文件发到公开地方"
}

do_show() {
  [ -f "$CONFIG_FILE" ] || die "还没安装, 配置 $CONFIG_FILE 不存在"
  local uuid pub shortid port sni
  uuid="$(existing_value uuid)"; port="$(existing_value port)"
  sni="$(existing_value sni)"; shortid="$(existing_value shortid)"
  local priv; priv="$(existing_value priv)"
  pub="$("$XRAY_BIN" x25519 -i "$priv" 2>/dev/null | grep -i 'public' | head -1 | sed -E 's/.*:[[:space:]]*//;s/[[:space:]]//g')"
  [ -n "$uuid" ] && [ -n "$pub" ] && [ -n "$shortid" ] || die "配置不完整, 请重装"
  show_info "$uuid" "$pub" "$shortid" "$port" "$sni"
}

do_reconfig() {
  need_root "$@"
  [ -f "$CONFIG_FILE" ] || die "还没安装, 配置 $CONFIG_FILE 不存在, 先跑 bash reality install"
  [ -n "${REALITY_SNI:-}" ] && validate_sni "$REALITY_SNI"
  [ -n "${REALITY_PORT:-}" ] && validate_port "$REALITY_PORT"
  detect_os; install_deps; detect_init
  [ -x "$XRAY_BIN" ] || download_xray

  local old_port old_sni old_uuid old_priv old_shortid
  old_port="$(existing_value port)"; old_sni="$(existing_value sni)"
  old_uuid="$(existing_value uuid)"; old_priv="$(existing_value priv)"
  old_shortid="$(existing_value shortid)"
  [ -n "$old_uuid" ] && [ -n "$old_priv" ] || die "配置不完整, 请删配置重装"

  local new_sni="${REALITY_SNI:-}" new_port="${REALITY_PORT:-}" ans=""
  local regen_keys="${REALITY_REGEN_KEYS:-0}" regen_uuid="${REALITY_REGEN_UUID:-0}"
  if [ -t 0 ]; then
    printf '%s\n' "当前配置: 域名 $old_sni  端口 $old_port  UUID $old_uuid"
    printf '新伪装域名 (回车保持 %s): ' "$old_sni"; read -r ans; [ -n "$ans" ] && new_sni="$ans"
    printf '新端口 (回车保持 %s, 别用 CF 反代端口): ' "$old_port"; read -r ans; [ -n "$ans" ] && new_port="$ans"
    printf '重新生成密钥 (新私钥/公钥 + 新 shortId)? [y/N]: '; read -r ans
    case "$ans" in y|Y|yes|YES) regen_keys=1 ;; esac
    if [ "$regen_keys" = "1" ]; then
      printf '同时换 UUID? [y/N]: '; read -r ans
      case "$ans" in y|Y|yes|YES) regen_uuid=1 ;; esac
    fi
  elif [ -z "$new_sni" ] && [ -z "$new_port" ] && [ "$regen_keys" != "1" ] && [ "$regen_uuid" != "1" ]; then
    die "非交互下改配置请给环境变量: REALITY_SNI=新域名 / REALITY_PORT=新端口 / REALITY_REGEN_KEYS=1 (换密钥) / REALITY_REGEN_UUID=1 (换 UUID)"
  fi
  [ -n "$new_sni" ] || new_sni="$old_sni"
  [ -n "$new_port" ] || new_port="$old_port"
  validate_port "$new_port"; validate_sni "$new_sni"
  if [ "$new_port" != "$old_port" ] && port_in_use "$new_port" && ! port_owner_is_xray "$new_port"; then
    die "端口 $new_port 已被占用, 请换一个未占用的端口"
  fi

  local uuid="$old_uuid" priv="$old_priv" shortid="$old_shortid" pub=""
  if [ "$regen_keys" = "1" ]; then
    local kp; kp="$(gen_keypair)"
    priv="$(printf '%s' "$kp" | sed -n '1p')"
    pub="$(printf '%s' "$kp" | sed -n '2p')"
    shortid="$(openssl rand -hex 8 2>/dev/null || head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    info "已重新生成密钥与 shortId"
  fi
  if [ "$regen_uuid" = "1" ]; then uuid="$(gen_uuid)"; info "已重新生成 UUID"; fi
  if [ -z "$pub" ]; then
    pub="$("$XRAY_BIN" x25519 -i "$priv" 2>/dev/null | grep -i 'public' | head -1 | sed -E 's/.*:[[:space:]]*//;s/[[:space:]]//g')"
    [ -n "$pub" ] || die "私钥无法反推公钥, 请检查配置"
  fi

  write_config "$uuid" "$priv" "$shortid" "$new_port" "$new_sni"
  stop_service
  start_service
  service_active || die "改配置后 Xray 未运行, 查日志: systemd 用 journalctl -u xray -n 50; OpenRC 用 rc-service xray status"
  if [ "$new_port" != "$old_port" ]; then
    open_firewall "$new_port"
    warn "旧端口 $old_port 的防火墙/安全组规则仍在, 不用了请手动关掉"
  fi
  try_bbr
  info "配置已改: 域名 $old_sni -> $new_sni, 端口 $old_port -> $new_port"
  [ "$regen_keys" = "1" ] && warn "密钥已换, 旧的 QuanX 行 / 链接 / 二维码全部作废, 请用下面新的"
  show_info "$uuid" "$pub" "$shortid" "$new_port" "$new_sni"
}

do_uninstall() {
  need_root "$@"
  detect_os; detect_init
  stop_service
  case "$INIT" in
    systemd)
      systemctl disable "$SERVICE_NAME" 2>/dev/null || true
      rm -f "/etc/systemd/system/${SERVICE_NAME}.service"
      systemctl daemon-reload 2>/dev/null || true
      ;;
    openrc)
      rc-update del "$SERVICE_NAME" default 2>/dev/null || true
      rm -f "/etc/init.d/${SERVICE_NAME}"
      ;;
  esac
  rm -f "$XRAY_BIN"
  if [ "${2:-}" = "--purge" ]; then
    rm -rf "$CONFIG_DIR" "$CLIENT_FILE" "$CLIENT_PNG"
    info "已彻底卸载 (含配置、客户端文件与二维码)"
  else
    info "已卸载程序, 配置保留在 $CONFIG_FILE, 重装会继续用它"
  fi
}

do_update() {
  need_root "$@"
  detect_os; install_deps; detect_init
  stop_service
  download_xray
  # 只换二进制, 配置不动, 密钥/UUID/端口全部保留
  "$XRAY_BIN" -test -config "$CONFIG_FILE" >/dev/null 2>&1 || \
    die "更新后配置校验失败, 旧配置在 $CONFIG_FILE, 请检查"
  start_service
  service_active || die "更新后 Xray 未运行"
  info "Xray 已更新到 $($XRAY_BIN version 2>/dev/null | head -1)"
  do_show
}

do_status() {
  detect_os 2>/dev/null || true
  [ -x "$XRAY_BIN" ] && info "Xray: $($XRAY_BIN version 2>/dev/null | head -1)" || info "Xray: 未安装"
  [ -f "$CONFIG_FILE" ] && info "配置: $CONFIG_FILE" || info "配置: 无"
  detect_init
  if service_active; then info "服务: 运行中"; else warn "服务: 未运行"; fi
}

menu() {
  printf '%s\n' "Xray VLESS + REALITY (主攻 QuanX) 一键脚本"
  printf '%s\n' "  1) 安装 / 重装 (会问伪装域名, 回车保持当前)"
  printf '%s\n' "  2) 查看客户端配置 (QuanX 行 + vless://)"
  printf '%s\n' "  3) 更新 Xray 到最新版"
  printf '%s\n' "  4) 重启服务"
  printf '%s\n' "  5) 卸载 (保留配置)"
  printf '%s\n' "  6) 更改配置 (域名 / 端口 / 密钥, 旧配置作废)"
  printf '%s\n' "  0) 退出"
  printf '请选择 [1-6/0]: '
  read -r choice
  case "$choice" in
    1) do_install "$@" ;;
    2) do_show ;;
    3) do_update "$@" ;;
    4) need_root "$@"; detect_init; start_service; service_active && info "服务已重启" || die "重启失败" ;;
    5) do_uninstall "$@" ;;
    6) do_reconfig "$@" ;;
    0) exit 0 ;;
    *) die "无效选择: $choice" ;;
  esac
}

case "${1:-}" in
  install|"") [ -n "${1:-}" ] || { [ -t 0 ] && menu "$@" || do_install "$@"; exit 0; }; do_install "$@" ;;
  show|info) do_show ;;
  reconfig|change) do_reconfig "$@" ;;
  update|upgrade) do_update "$@" ;;
  restart) need_root "$@"; detect_init; start_service; service_active && info "服务已重启" || die "重启失败" ;;
  status) do_status ;;
  uninstall|remove) do_uninstall "$@" ;;
  -h|--help|help)
    printf '%s\n' "用法: bash reality [install|reconfig|show|update|restart|status|uninstall [--purge]]"
    printf '%s\n' "无参数时: 有终端进菜单, 无终端 (管道/重定向) 直接安装"
    printf '%s\n' "reconfig: 改伪装域名 / 端口 / 重新生成密钥, 旧的客户端配置作废"
    printf '%s\n' "安装时有终端会提示自选伪装域名, 回车保持默认/当前; 非交互用 REALITY_SNI=域名指定"
    printf '%s\n' "环境变量: REALITY_PORT REALITY_SNI REALITY_TAG REALITY_HOST REALITY_UUID XRAY_VERSION"
    printf '%s\n' "改配置非交互: REALITY_SNI=.. REALITY_PORT=.. REALITY_REGEN_KEYS=1 REALITY_REGEN_UUID=1 bash reality reconfig"
    ;;
  *) die "未知命令: $1, 用 bash reality --help 看用法" ;;
esac
